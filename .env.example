LITELLM_GATEWAY_URL=
LITELLM_API_KEY=
LITELLM_MODEL=claude-sonnet-4-6

# Mem0 self-hosted server (running locally from ../mem0/server).
# Start it with: cd ../mem0/server && make bootstrap  → grab the printed API key.
MEM0_SERVER_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_USER_ID=default_user

# Required for claude-agent-sdk (gateway rejects context_management).
ANTHROPIC_API_KEY=sk-ant-...

# Glean MCP. Required for the mem-writer source-digest pipeline (every source is
# reached only through Glean) and the Graphiti-first chat UI's Glean augmentation.
# URL is the host only; the app (and .mcp.json) append /mcp/default.
GLEAN_MCP_URL=
GLEAN_MCP_AUTH_TOKEN=

# Granola public API key (Granola desktop app -> Settings -> Connectors -> API keys).
# Used by the first-party Granola MCP server (src/granola_mcp_server.py) for the
# mem-writer granola digest, since Glean does not index Granola. Format: grn_...
GRANOLA_API_KEY=

# mem-writer digest pipeline (optional).
# DIGEST_USER_EMAIL sharpens Glean to:/from:/cc: filters; defaults to the
# Glean-authenticated user when blank.
DIGEST_USER_EMAIL=
# Default lookback window for the daily digest, in hours.
DIGEST_TIMEFRAME_HOURS=24

# --- agent-sentry (generic briefing agent) ---
# Identity a skill's `self` / `@me` relay target resolves to (e.g. DM the user their own
# brief). Falls back to DIGEST_USER_EMAIL when blank.
SENTRY_USER_EMAIL=
# Slack relay: bot token used by the first-party Slack MCP server (src/slack_mcp_server.py)
# when a skill's frontmatter relays to slack. Scopes: chat:write (post); plus users:read.email
# and im:write so a brief can be DM'd to a user given their email. Format: xoxb-...
SLACK_BOT_TOKEN=
# Email relay: SMTP settings for the first-party email MCP server (src/email_mcp_server.py),
# used when a skill's frontmatter relays to email. SMTP_PORT defaults to 587 (STARTTLS);
# SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# HTTP API auth (src/sentry_api.py): required X-API-Key for the UI. Generate a random value;
# the API refuses to serve if this is unset. Optional: SENTRY_RATE_LIMIT_PER_MIN (default 10).
SENTRY_API_KEY=
SENTRY_RATE_LIMIT_PER_MIN=10
